{
  "name": "@emerald-city/worldgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "World generator: a city spec (written by hand or by Claude from a description) becomes a laid-out city in a world manifest.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx src/cli.ts generate",
    "describe": "tsx src/cli.ts describe"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@emerald-city/world": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
