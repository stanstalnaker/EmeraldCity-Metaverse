# HubID API (server-side only: never expose these to the browser)
HUBID_API_URL=https://id.hubculture.com
HUBID_PUBLIC_KEY=
HUBID_PRIVATE_KEY=

# Territory used to scope city properties (HubID pavilions.territory)
CITY_TERRITORY=Emerald City

# Gaia map layer: any MapLibre-compatible style URL (OpenFreeMap needs no key)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Presence server
PRESENCE_PORT=8787
# Shared secret used to verify HubID JWTs (HS256), same value as hubid_api JWT_SECRET
HUBID_JWT_SECRET=
NEXT_PUBLIC_PRESENCE_URL=ws://localhost:8787

# LiveKit (voice/video). Same project for presence (token issuing) and the Zeke voice worker.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker name presence dispatches into property rooms when voice starts
LIVEKIT_CONCIERGE_AGENT=zeke-concierge
VITE_PRESENCE_URL=ws://localhost:8787

# Zeke (hub-culture/zeke-ai-server). Server-side only.
ZEKE_API_URL=https://zeke.example
ZEKE_SYSTEM_TOKEN=
# Zeke's own HubID agent token (bot sub-profile) for presence
ZEKE_HUBID_TOKEN=
ZEKE_ROOMS=map
# Agents can address named services: "zeke" -> Zeke's HubID id
PRESENCE_SERVICES=zeke:39
# Voice worker models/providers
ZEKE_VOICE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
